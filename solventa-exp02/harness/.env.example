# Plantilla de configuracion del arnes de EXP-02.
#
# Copiar a .env y ajustar. El archivo .env esta en .gitignore y NUNCA se
# versiona. Este archivo, en cambio, si se versiona: es documentacion.
#
#     cp .env.example .env
#
# NO escribir aqui credenciales, claves ni certificados reales. Solo ejemplos.

# ---------------------------------------------------------------------------
# Modo de ejecucion: simulado | mixto | real
# ---------------------------------------------------------------------------
# simulado -> todo contra dobles de prueba del arnes
# mixto    -> parte real, parte doble (integracion incremental)
# real     -> solo servicios reales; UNICO modo con evidencia valida
MODO=simulado

# Identificador de la corrida. Si se deja vacio, el arnes genera uno con marca
# de tiempo UTC: exp02_<AAAAMMDD>T<HHMMSS>Z_<modo>
# RUN_ID=

# ---------------------------------------------------------------------------
# Endpoints de los componentes bajo prueba
# ---------------------------------------------------------------------------
# Puertos 51xx para no colisionar con EXP-01 (que usa 3000/5000/8000/9090/15672).
# Los valores definitivos los fija Donaldo en el docker-compose de EXP-02.
MS_PAGOS_URL=https://localhost:5101
TOKENIZADOR_URL=https://localhost:5102
AUDITORIA_URL=https://localhost:5103

# ---------------------------------------------------------------------------
# Mensajeria asincrona (Kafka)
# ---------------------------------------------------------------------------
KAFKA_BOOTSTRAP=localhost:9094
TOPIC_EVENTOS=solventa.pagos.eventos
TOPIC_AUDITORIA=solventa.auditoria

# ---------------------------------------------------------------------------
# Material criptografico: SOLO RUTAS
# ---------------------------------------------------------------------------
# Los archivos los genera el script de certificados de EXP-02 y estan
# ignorados por git. Aqui se indica donde encontrarlos, jamas su contenido.
DIR_CERTS=../certs
CA_BUNDLE=../certs/ca.crt
CERT_CLIENTE=../certs/harness.crt
CLAVE_CLIENTE=../certs/harness.key

# Par firmado por una CA distinta, para el caso negativo de mTLS.
# Es material de prueba intencionalmente invalido, no un secreto.
CERT_NO_CONFIABLE=../certs/no_confiable.crt
CLAVE_NO_CONFIABLE=../certs/no_confiable.key

# ---------------------------------------------------------------------------
# Acceso de solo lectura al almacen de MS Pagos
# ---------------------------------------------------------------------------
# Necesario para comprobar que el PAN no se persiste.
# Ejemplo de FORMATO unicamente: usar un usuario de solo lectura del entorno
# experimental y definir el valor real en tu .env local, nunca aqui.
# ALMACEN_DSN=postgresql://USUARIO:CLAVE@localhost:5432/BASE

# ---------------------------------------------------------------------------
# Parametros de ejecucion
# ---------------------------------------------------------------------------
TIMEOUT_S=10
LOG_LEVEL=INFO
SERVICE_ID=harness

# Carpeta de salida de la evidencia. Su contenido esta en .gitignore.
DIR_EVIDENCIAS=../evidencias
